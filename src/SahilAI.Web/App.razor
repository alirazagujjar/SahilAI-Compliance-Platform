<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Sahil AI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] }
                }
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <HeadOutlet />
    <style>
        body { font-family: 'Inter', ui-sans-serif, system-ui; }
        .pulse-once { animation: pulse-once 0.6s ease-out; }
        @@keyframes pulse-once { 0%,100% { background-color: transparent; } 40% { background-color: rgba(99,102,241,0.08); } }
    </style>
</head>
<body class="bg-slate-50 text-gray-900 antialiased">
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/charts.js"></script>
</body>
</html>
