@using SahilAI.Web.Components.Layout
@rendermode InteractiveServer

<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found — Sahil AI</PageTitle>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="flex flex-col items-center justify-center py-32 text-center">
                <p class="text-6xl font-bold text-slate-200">404</p>
                <p class="text-slate-500 mt-4">Page not found.</p>
                <a href="/" class="mt-6 px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm hover:bg-indigo-700 transition-colors">
                    Return to dashboard
                </a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
