@code {
    [Parameter, EditorRequired] public string Status { get; set; } = "";

    private string Css => Status switch
    {
        InvoiceStatus.Valid             => "bg-emerald-100 text-emerald-700",
        InvoiceStatus.Review            => "bg-amber-100  text-amber-700",
        InvoiceStatus.Flagged           => "bg-orange-100 text-orange-700",
        InvoiceStatus.Duplicate         => "bg-red-100    text-red-700",
        InvoiceStatus.Approved          => "bg-indigo-100 text-indigo-700",
        InvoiceStatus.Error             => "bg-red-100    text-red-600",
        InvoiceStatus.NotSupportedFormat=> "bg-slate-100  text-slate-500",
        _                               => "bg-slate-100  text-slate-600",
    };
}

<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @Css">@Status</span>
