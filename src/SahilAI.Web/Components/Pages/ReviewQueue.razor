@page "/review"
@rendermode InteractiveServer
@inject IInvoiceRepository InvoiceRepo
@inject NavigationManager Nav
@inject LiveCountService LiveCounts
@implements IDisposable

<PageTitle>Review Queue — Sahil AI</PageTitle>

<div class="space-y-5 max-w-7xl">

    <!-- ── Header ─────────────────────────────────────────────────────────────── -->
    <div class="flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-amber-500 uppercase tracking-widest mb-1">Action Required</p>
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Review Queue</h1>
            <p class="text-slate-400 text-sm mt-0.5">Invoices with confidence &lt;90% awaiting human verification.</p>
        </div>
        <div class="flex items-center gap-3">
            @if (LiveCounts.IsReady)
            {
                <div class="flex items-center gap-1.5 bg-emerald-50 border border-emerald-200 rounded-full px-3 py-1.5">
                    <span class="relative flex h-1.5 w-1.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                    </span>
                    <span class="text-xs font-semibold text-emerald-700">Live</span>
                </div>
            }
            <button @onclick="RefreshAsync"
                    class="flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-sm text-slate-600 font-medium transition-colors shadow-sm">
                <svg class="w-4 h-4 @(isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Refresh
            </button>
        </div>
    </div>

    <!-- ── Arrival banner ──────────────────────────────────────────────────── -->
    @if (pendingArrivals.Count > 0)
    {
        <div class="bg-indigo-600 text-white rounded-2xl px-5 py-4 flex items-center gap-4 shadow-lg shadow-indigo-200">
            <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <p class="font-bold text-sm">@pendingArrivals.Count new invoice@(pendingArrivals.Count == 1 ? "" : "s") arrived</p>
                <p class="text-indigo-200 text-xs mt-0.5 truncate">
                    @string.Join(" · ", pendingArrivals.TakeLast(3).Select(i => i.InvoiceNumber))
                    @if (pendingArrivals.Count > 3) { <span>+@(pendingArrivals.Count - 3) more</span> }
                </p>
            </div>
            <button @onclick="LoadNewArrivalsAsync"
                    class="flex-shrink-0 bg-white text-indigo-600 hover:bg-indigo-50 text-sm font-bold px-4 py-2 rounded-xl transition-colors">
                Load now
            </button>
            <button @onclick="() => pendingArrivals.Clear()"
                    class="flex-shrink-0 text-indigo-300 hover:text-white transition-colors p-1.5 rounded-lg hover:bg-white/10">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
    }

    <!-- ── Loading ─────────────────────────────────────────────────────────── -->
    @if (isLoading)
    {
        <div class="flex items-center gap-3 text-slate-400 text-sm py-12 justify-center">
            <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
            </svg>
            Loading queue…
        </div>
    }
    else if (!queue.Any())
    {
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm py-24 text-center">
            <div class="w-14 h-14 bg-emerald-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
            <p class="text-slate-700 font-bold text-base">Queue is empty</p>
            <p class="text-slate-400 text-sm mt-1">No invoices pending human review. Great work!</p>
        </div>
    }
    else
    {
        <!-- Stats bar -->
        <div class="grid grid-cols-3 gap-4">
            <div class="bg-white rounded-xl border border-slate-100 shadow-sm px-4 py-3 flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center">
                    <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-lg font-extrabold text-slate-800 tabular-nums leading-none">@queue.Count()</p>
                    <p class="text-xs text-slate-400 font-medium mt-0.5">Pending</p>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-100 shadow-sm px-4 py-3 flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center">
                    <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-lg font-extrabold text-slate-800 tabular-nums leading-none">
                        @((queue.Average(i => i.ConfidenceScore) * 100).ToString("F0"))%
                    </p>
                    <p class="text-xs text-slate-400 font-medium mt-0.5">Avg confidence</p>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-100 shadow-sm px-4 py-3 flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-red-100 flex items-center justify-center">
                    <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-lg font-extrabold text-slate-800 tabular-nums leading-none">@queue.Sum(i => AnomalyCount(i.AnomalyFlags))</p>
                    <p class="text-xs text-slate-400 font-medium mt-0.5">Total issues</p>
                </div>
            </div>
        </div>

        <!-- Search + table -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">

            <!-- Search bar -->
            <div class="px-4 py-3 border-b border-slate-50 flex items-center gap-3">
                <div class="relative flex-1">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
                    </svg>
                    <input type="text"
                           placeholder="Search invoice # or vendor…"
                           value="@searchText"
                           @oninput="@(e => searchText = e.Value?.ToString() ?? "")"
                           class="w-full pl-9 pr-4 py-2 text-sm border border-slate-200 rounded-xl bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-300 focus:border-indigo-400 placeholder-slate-400 text-slate-700 transition-colors" />
                </div>
                <span class="text-xs text-slate-400 flex-shrink-0">
                    @if (!string.IsNullOrWhiteSpace(searchText))
                    {
                        <span class="text-indigo-600 font-semibold">@FilteredQueue.Count()</span>
                        <span> of @queue.Count()</span>
                    }
                    else
                    {
                        <span class="font-semibold">@queue.Count()</span>
                        <span> invoice@(queue.Count() == 1 ? "" : "s")</span>
                    }
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead>
                        <tr class="bg-slate-50/70 text-[11px] text-slate-400 uppercase tracking-widest border-b border-slate-100">
                            <th class="px-5 py-3 text-left font-semibold w-4"></th>
                            <th class="px-5 py-3 text-left font-semibold">Invoice #</th>
                            <th class="px-5 py-3 text-left font-semibold">Vendor</th>
                            <th class="px-5 py-3 text-left font-semibold w-36">Confidence</th>
                            <th class="px-5 py-3 text-left font-semibold">Region</th>
                            <th class="px-5 py-3 text-right font-semibold">Amount</th>
                            <th class="px-5 py-3 text-center font-semibold">Issues</th>
                            <th class="px-5 py-3 text-left font-semibold">Received</th>
                            <th class="px-5 py-3 text-left font-semibold">Type</th>
                            <th class="px-5 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        @foreach (var inv in FilteredQueue)
                        {
                            var isNew       = newlyLoadedIds.Contains(inv.Id);
                            var issueCount  = AnomalyCount(inv.AnomalyFlags);
                            var urgency     = inv.ConfidenceScore < 0.60m ? "high"
                                            : inv.ConfidenceScore < 0.75m ? "medium"
                                            : "low";
                            var urgencyDot  = urgency switch
                            {
                                "high"   => "bg-red-400",
                                "medium" => "bg-amber-400",
                                _        => "bg-slate-300"
                            };

                            <tr class="hover:bg-indigo-50/30 transition-colors cursor-pointer @(isNew ? "bg-indigo-50/40" : "")"
                                @onclick="@(() => Nav.NavigateTo($"/review/{inv.Id}"))">

                                <!-- Urgency dot -->
                                <td class="pl-5 pr-1 py-4">
                                    <span class="w-2 h-2 rounded-full @urgencyDot inline-block" title="@urgency priority"></span>
                                </td>

                                <!-- Invoice # -->
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-2">
                                        @if (isNew)
                                        {
                                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 flex-shrink-0 animate-pulse"></span>
                                        }
                                        <span class="font-mono text-xs text-indigo-600 font-bold">@inv.InvoiceNumber</span>
                                    </div>
                                </td>

                                <!-- Vendor -->
                                <td class="px-5 py-4 text-sm text-slate-700 font-medium max-w-[180px] truncate">
                                    @inv.VendorName
                                </td>

                                <!-- Confidence -->
                                <td class="px-5 py-4 w-36">
                                    <ConfidenceBar Score="@inv.ConfidenceScore" />
                                </td>

                                <!-- Region -->
                                <td class="px-5 py-4">
                                    <RegionBadge Region="@inv.Region" />
                                </td>

                                <!-- Amount -->
                                <td class="px-5 py-4 text-right text-sm font-bold text-slate-700 tabular-nums whitespace-nowrap">
                                    @inv.Currency&nbsp;@inv.GrandTotal.ToString("N2")
                                </td>

                                <!-- Issues -->
                                <td class="px-5 py-4 text-center">
                                    @if (issueCount > 0)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-600">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01"/>
                                            </svg>
                                            @issueCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-200 text-sm">—</span>
                                    }
                                </td>

                                <!-- Received -->
                                <td class="px-5 py-4">
                                    <p class="text-xs text-slate-500 font-medium whitespace-nowrap">@inv.CreatedAt.ToString("dd MMM yyyy")</p>
                                    <p class="text-[11px] text-slate-300 mt-0.5">@inv.CreatedAt.ToString("HH:mm") UTC</p>
                                </td>

                                <!-- File type -->
                                <td class="px-5 py-4">
                                    <span class="px-2 py-0.5 bg-slate-100 text-slate-500 rounded-md text-xs font-mono font-medium">
                                        @(inv.FileType?.TrimStart('.').ToUpperInvariant() ?? "—")
                                    </span>
                                </td>

                                <!-- Action -->
                                <td class="px-5 py-4 text-right">
                                    <button @onclick="@(() => Nav.NavigateTo($"/review/{inv.Id}"))"
                                            @onclick:stopPropagation="true"
                                            class="flex items-center gap-1.5 px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg transition-colors whitespace-nowrap shadow-sm shadow-indigo-200">
                                        Review
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!string.IsNullOrWhiteSpace(searchText) && !FilteredQueue.Any())
                {
                    <div class="py-12 text-center">
                        <p class="text-slate-500 text-sm">No invoices match "<strong>@searchText</strong>"</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<Invoice> queue  = [];
    private bool isLoading              = true;
    private string searchText           = "";

    private readonly List<Invoice> pendingArrivals = [];
    private readonly HashSet<int>  newlyLoadedIds  = [];

    private IEnumerable<Invoice> FilteredQueue =>
        string.IsNullOrWhiteSpace(searchText)
            ? queue
            : queue.Where(i =>
                i.InvoiceNumber.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                i.VendorName.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        LiveCounts.NewReviewInvoice   += OnNewInvoiceArrived;
        LiveCounts.ReviewQueueChanged += OnReviewQueueChanged;
        await LoadAsync();
    }

    private void OnNewInvoiceArrived(Invoice inv)
    {
        pendingArrivals.Add(inv);
        InvokeAsync(StateHasChanged);
    }

    private void OnReviewQueueChanged()
        => InvokeAsync(async () =>
        {
            queue = await InvoiceRepo.GetReviewQueueAsync();
            StateHasChanged();
        });

    private async Task RefreshAsync() => await LoadAsync();

    private async Task LoadNewArrivalsAsync()
    {
        var ids = pendingArrivals.Select(i => i.Id).ToHashSet();
        newlyLoadedIds.UnionWith(ids);
        pendingArrivals.Clear();
        queue = await InvoiceRepo.GetReviewQueueAsync();

        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            newlyLoadedIds.Clear();
            await InvokeAsync(StateHasChanged);
        });

        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        StateHasChanged();
        queue     = await InvoiceRepo.GetReviewQueueAsync();
        isLoading = false;
    }

    public void Dispose()
    {
        LiveCounts.NewReviewInvoice   -= OnNewInvoiceArrived;
        LiveCounts.ReviewQueueChanged -= OnReviewQueueChanged;
    }

    private static int AnomalyCount(string? json)
    {
        if (string.IsNullOrEmpty(json)) return 0;
        try
        {
            using var doc = JsonDocument.Parse(json);
            return doc.RootElement.ValueKind == JsonValueKind.Array
                ? doc.RootElement.GetArrayLength() : 0;
        }
        catch { return 0; }
    }
}
