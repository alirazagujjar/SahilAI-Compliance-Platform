@page "/review"
@rendermode InteractiveServer
@inject IInvoiceRepository InvoiceRepo
@inject NavigationManager Nav
@inject LiveCountService LiveCounts
@implements IDisposable

<PageTitle>Review Queue — Sahil AI</PageTitle>

<div class="space-y-5 max-w-7xl">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Review Queue</h1>
            <p class="text-slate-500 text-sm mt-0.5">
                Invoices with confidence &lt; 90% awaiting human verification before approval.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <!-- Live indicator -->
            @if (LiveCounts.IsReady)
            {
                <div class="flex items-center gap-1.5 text-xs text-emerald-600 font-medium">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    Live
                </div>
            }
            <button @onclick="RefreshAsync"
                    class="flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-sm text-slate-600 transition-colors shadow-sm">
                <svg class="w-4 h-4 @(isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Refresh
            </button>
        </div>
    </div>

    <!-- ── New invoice arrival banner ── -->
    @if (pendingArrivals.Count > 0)
    {
        <div class="bg-indigo-600 text-white rounded-xl px-5 py-3.5 flex items-center gap-4 shadow-lg shadow-indigo-200">
            <!-- Animated inbox icon -->
            <div class="w-9 h-9 bg-white/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <p class="font-semibold text-sm">
                    @pendingArrivals.Count new invoice@(pendingArrivals.Count == 1 ? "" : "s") arrived
                </p>
                <p class="text-indigo-200 text-xs mt-0.5 truncate">
                    @string.Join(" · ", pendingArrivals.TakeLast(3).Select(i => i.InvoiceNumber))
                    @if (pendingArrivals.Count > 3) { <span>+ @(pendingArrivals.Count - 3) more</span> }
                </p>
            </div>
            <button @onclick="LoadNewArrivalsAsync"
                    class="flex-shrink-0 bg-white text-indigo-600 hover:bg-indigo-50 text-sm font-semibold px-4 py-1.5 rounded-lg transition-colors">
                Load now
            </button>
            <button @onclick="() => pendingArrivals.Clear()"
                    class="flex-shrink-0 text-indigo-200 hover:text-white transition-colors p-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
    }

    <!-- ── Main content ── -->
    @if (isLoading)
    {
        <div class="flex items-center gap-2 text-slate-400 text-sm py-10">
            <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
            </svg>
            Loading queue&hellip;
        </div>
    }
    else if (!queue.Any())
    {
        <div class="bg-white rounded-xl border border-slate-200 py-24 text-center">
            <div class="w-12 h-12 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
            <p class="text-slate-700 font-medium">All clear!</p>
            <p class="text-slate-400 text-sm mt-1">No invoices pending review.</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
            <div class="px-6 py-3 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">
                    @queue.Count() invoice@(queue.Count() == 1 ? "" : "s") pending
                </span>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead>
                        <tr class="text-xs text-slate-400 uppercase tracking-wide border-b border-slate-100">
                            <th class="px-6 py-3 text-left font-medium">Invoice #</th>
                            <th class="px-6 py-3 text-left font-medium">Vendor</th>
                            <th class="px-6 py-3 text-left font-medium">Confidence</th>
                            <th class="px-6 py-3 text-left font-medium">Region</th>
                            <th class="px-6 py-3 text-right font-medium">Amount</th>
                            <th class="px-6 py-3 text-center font-medium">Issues</th>
                            <th class="px-6 py-3 text-left font-medium">Received</th>
                            <th class="px-6 py-3 text-left font-medium">Type</th>
                            <th class="px-6 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        @foreach (var inv in queue)
                        {
                            var isNew = newlyLoadedIds.Contains(inv.Id);
                            <tr class="hover:bg-indigo-50/30 transition-colors cursor-pointer @(isNew ? "bg-indigo-50/50 animate-pulse-once" : "")"
                                @onclick="@(() => Nav.NavigateTo($"/review/{inv.Id}"))">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2">
                                        @if (isNew)
                                        {
                                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 flex-shrink-0"></span>
                                        }
                                        <span class="font-mono text-xs text-indigo-600 font-semibold">@inv.InvoiceNumber</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-700 max-w-[180px] truncate">
                                    @inv.VendorName
                                </td>
                                <td class="px-6 py-4">
                                    <ConfidenceBar Score="@inv.ConfidenceScore" />
                                </td>
                                <td class="px-6 py-4">
                                    <RegionBadge Region="@inv.Region" />
                                </td>
                                <td class="px-6 py-4 text-right text-sm font-semibold text-slate-700">
                                    @inv.Currency&nbsp;@inv.GrandTotal.ToString("N2")
                                </td>
                                <td class="px-6 py-4 text-center">
                                    @{var cnt = AnomalyCount(inv.AnomalyFlags);}
                                    @if (cnt > 0)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-600">
                                            @cnt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300 text-xs">—</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-400 whitespace-nowrap">
                                    @inv.CreatedAt.ToString("dd MMM yyyy")
                                    <br />
                                    <span class="text-slate-300">@inv.CreatedAt.ToString("HH:mm") UTC</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-0.5 bg-slate-100 text-slate-500 rounded text-xs font-mono">
                                        @inv.FileType
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <button @onclick="@(() => Nav.NavigateTo($"/review/{inv.Id}"))"
                                            @onclick:stopPropagation="true"
                                            class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition-colors whitespace-nowrap">
                                        Review &rarr;
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<Invoice> queue = [];
    private bool isLoading = true;

    // Live tracking
    private readonly List<Invoice> pendingArrivals = [];
    private readonly HashSet<int>  newlyLoadedIds  = [];

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        LiveCounts.NewReviewInvoice  += OnNewInvoiceArrived;
        LiveCounts.ReviewQueueChanged += OnReviewQueueChanged;
        await LoadAsync();
    }

    // ── Live handlers ─────────────────────────────────────────────────────────

    /// A new invoice entered the review queue — show the arrival banner.
    private void OnNewInvoiceArrived(Invoice inv)
    {
        pendingArrivals.Add(inv);
        InvokeAsync(StateHasChanged);
    }

    /// Queue changed (item removed/approved elsewhere) — silently reload.
    private void OnReviewQueueChanged()
        => InvokeAsync(async () =>
        {
            queue = await InvoiceRepo.GetReviewQueueAsync();
            StateHasChanged();
        });

    // ── User actions ──────────────────────────────────────────────────────────

    private async Task RefreshAsync() => await LoadAsync();

    /// User clicked "Load now" in the arrival banner — merge new items into table.
    private async Task LoadNewArrivalsAsync()
    {
        var ids = pendingArrivals.Select(i => i.Id).ToHashSet();
        newlyLoadedIds.UnionWith(ids);
        pendingArrivals.Clear();

        queue = await InvoiceRepo.GetReviewQueueAsync();

        // Clear the highlight after 4 s
        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            newlyLoadedIds.Clear();
            await InvokeAsync(StateHasChanged);
        });

        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        StateHasChanged();
        queue     = await InvoiceRepo.GetReviewQueueAsync();
        isLoading = false;
    }

    public void Dispose()
    {
        LiveCounts.NewReviewInvoice   -= OnNewInvoiceArrived;
        LiveCounts.ReviewQueueChanged -= OnReviewQueueChanged;
    }

    private static int AnomalyCount(string? json)
    {
        if (string.IsNullOrEmpty(json)) return 0;
        try
        {
            using var doc = JsonDocument.Parse(json);
            return doc.RootElement.ValueKind == JsonValueKind.Array
                ? doc.RootElement.GetArrayLength()
                : 0;
        }
        catch { return 0; }
    }
}
