@page "/vendor"
@layout VendorLayout
@attribute [Authorize(Roles = "Vendor")]
@using SahilAI.Web.Components.Layout
@inject IInvoiceRepository InvoiceRepo
@inject IVendorRepository VendorRepo
@inject AuthenticationStateProvider AuthState

<PageTitle>Dashboard — Vendor Portal</PageTitle>

<div class="max-w-4xl mx-auto">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Welcome back, @_firstName</h1>
        <p class="text-sm text-slate-500 mt-0.5">Here's an overview of your invoice submissions</p>
    </div>

    <!-- Stat cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        @StatCard("Total Submitted", _total,   "border-t-slate-400",   "bg-slate-100",   "text-slate-600")
        @StatCard("In Review",       _review,  "border-t-amber-400",   "bg-amber-50",    "text-amber-600")
        @StatCard("Approved",        _approved,"border-t-emerald-400", "bg-emerald-50",  "text-emerald-600")
        @StatCard("Action Needed",   _flagged, "border-t-red-400",     "bg-red-50",      "text-red-600")
    </div>

    <!-- Recent invoices -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-slate-700">Recent Submissions</h2>
            <a href="/vendor/invoices" class="text-xs text-indigo-600 hover:text-indigo-700 font-medium transition-colors">View all →</a>
        </div>

        @if (_loading)
        {
            <div class="px-6 py-10 text-center text-slate-400 text-sm">Loading…</div>
        }
        else if (_recent.Count == 0)
        {
            <div class="px-6 py-10 text-center">
                <svg class="w-10 h-10 text-slate-200 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p class="text-slate-400 text-sm mb-3">No invoices yet.</p>
                <a href="/vendor/upload"
                   class="inline-block bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold rounded-lg px-4 py-2 transition-colors">
                    Submit your first invoice
                </a>
            </div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/60">
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Invoice</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Date</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Amount</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var inv in _recent)
                    {
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-6 py-3 font-medium text-slate-700">@inv.InvoiceNumber</td>
                            <td class="px-4 py-3 text-slate-400 text-xs">@inv.InvoiceDate.ToString("dd MMM yyyy")</td>
                            <td class="px-4 py-3 text-right font-mono text-slate-700">
                                @inv.GrandTotal.ToString("N2") @inv.Currency
                            </td>
                            <td class="px-4 py-3">@StatusBadge(inv.Status)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private bool   _loading   = true;
    private string _firstName = "there";
    private string _trn       = string.Empty;

    private int _total, _review, _approved, _flagged;
    private List<Invoice> _recent = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user  = state.User;
        var name  = user.Identity?.Name ?? "";
        _firstName = name.Split(' ').FirstOrDefault() ?? name;

        var vendorIdStr = user.FindFirst("vendor_id")?.Value;
        if (!string.IsNullOrEmpty(vendorIdStr) && int.TryParse(vendorIdStr, out var vendorId))
        {
            var vendor = await VendorRepo.GetByIdAsync(vendorId);
            _trn = vendor?.TaxRegNumber ?? string.Empty;
        }

        if (!string.IsNullOrEmpty(_trn))
        {
            var counts = await InvoiceRepo.GetStatusCountsByVendorTrnAsync(_trn);
            _total    = counts.Values.Sum();
            counts.TryGetValue("REVIEW",   out _review);
            int v, a;
            counts.TryGetValue("VALID",    out v);
            counts.TryGetValue("APPROVED", out a);
            _approved = v + a;
            counts.TryGetValue("FLAGGED",  out _flagged);

            var all    = await InvoiceRepo.GetByVendorTrnAsync(_trn);
            _recent    = all.Take(5).ToList();
        }

        _loading = false;
    }

    private RenderFragment StatCard(string label, int value, string border, string iconBg, string iconText) =>
        @<div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm @border border-t-4">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">@label</p>
            <p class="text-3xl font-extrabold text-slate-800">@value</p>
        </div>;

    private RenderFragment StatusBadge(string status)
    {
        var (bg, text, dot) = status switch
        {
            "VALID" or "APPROVED" => ("bg-emerald-50 border-emerald-200 text-emerald-700", "", "bg-emerald-500"),
            "REVIEW"              => ("bg-amber-50 border-amber-200 text-amber-700",   "", "bg-amber-400"),
            "FLAGGED"             => ("bg-red-50 border-red-200 text-red-700",         "", "bg-red-500"),
            "PENDING"             => ("bg-slate-100 border-slate-200 text-slate-600",  "", "bg-slate-400"),
            _                     => ("bg-slate-100 border-slate-200 text-slate-500",  "", "bg-slate-400"),
        };
        return @<span class="inline-flex items-center gap-1.5 text-xs font-semibold border rounded-full px-2.5 py-0.5 @bg">
                    <span class="w-1.5 h-1.5 rounded-full @dot"></span>@status
               </span>;
    }
}
