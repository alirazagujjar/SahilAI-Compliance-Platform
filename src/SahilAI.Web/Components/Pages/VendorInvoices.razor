@page "/vendor/invoices"
@layout VendorLayout
@attribute [Authorize(Roles = "Vendor")]
@using SahilAI.Web.Components.Layout
@inject IInvoiceRepository InvoiceRepo
@inject IVendorRepository VendorRepo
@inject AuthenticationStateProvider AuthState

<PageTitle>My Invoices — Vendor Portal</PageTitle>

<div class="max-w-5xl mx-auto">

    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">My Invoices</h1>
            <p class="text-sm text-slate-500 mt-0.5">All invoices submitted under your TRN</p>
        </div>
        <a href="/vendor/upload"
           class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl px-4 py-2.5 text-sm transition-colors shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Submit Invoice
        </a>
    </div>

    <!-- Filter bar -->
    <div class="flex items-center gap-3 mb-4">
        <input @bind="_search" @bind:event="oninput" placeholder="Search by invoice number…"
               class="flex-1 max-w-xs border border-slate-200 rounded-lg px-3.5 py-2 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" />
        <select @bind="_statusFilter"
                class="border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500">
            <option value="">All statuses</option>
            <option value="PENDING">Pending</option>
            <option value="REVIEW">In Review</option>
            <option value="VALID">Valid</option>
            <option value="APPROVED">Approved</option>
            <option value="FLAGGED">Flagged</option>
        </select>
    </div>

    <!-- Table -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        @if (_loading)
        {
            <div class="px-6 py-12 text-center text-slate-400 text-sm">Loading…</div>
        }
        else if (!_filtered.Any())
        {
            <div class="px-6 py-12 text-center text-slate-400 text-sm">No invoices match your filter.</div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/60">
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Invoice #</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Date</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Total</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Submitted</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var inv in _filtered)
                    {
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-6 py-3.5 font-medium text-slate-800">@inv.InvoiceNumber</td>
                            <td class="px-4 py-3.5 text-slate-500 text-xs">@inv.InvoiceDate.ToString("dd MMM yyyy")</td>
                            <td class="px-4 py-3.5 text-right font-mono text-slate-700 text-xs">
                                @inv.GrandTotal.ToString("N2") <span class="text-slate-400">@inv.Currency</span>
                            </td>
                            <td class="px-4 py-3.5">
                                @{
                                    var (bg, dot) = inv.Status switch
                                    {
                                        "VALID" or "APPROVED" => ("bg-emerald-50 border-emerald-200 text-emerald-700", "bg-emerald-500"),
                                        "REVIEW"              => ("bg-amber-50 border-amber-200 text-amber-700", "bg-amber-400"),
                                        "FLAGGED"             => ("bg-red-50 border-red-200 text-red-700", "bg-red-500"),
                                        _                     => ("bg-slate-100 border-slate-200 text-slate-600", "bg-slate-400"),
                                    };
                                }
                                <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold border rounded-full px-2.5 py-0.5 @bg">
                                    <span class="w-1.5 h-1.5 rounded-full @dot"></span>@inv.Status
                                </span>
                            </td>
                            <td class="px-4 py-3.5 text-slate-400 text-xs">@inv.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="px-6 py-3 border-t border-slate-100 text-xs text-slate-400">
                Showing @_filtered.Count() of @_invoices.Count invoices
            </div>
        }
    </div>
</div>

@code {
    private bool   _loading = true;
    private string _trn     = string.Empty;
    private string _search  = string.Empty;
    private string _statusFilter = string.Empty;

    private List<Invoice> _invoices = [];
    private IEnumerable<Invoice> _filtered => _invoices
        .Where(i => string.IsNullOrEmpty(_search)       || i.InvoiceNumber.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(i => string.IsNullOrEmpty(_statusFilter) || i.Status == _statusFilter);

    protected override async Task OnInitializedAsync()
    {
        var state     = await AuthState.GetAuthenticationStateAsync();
        var vendorStr = state.User.FindFirst("vendor_id")?.Value;
        if (!string.IsNullOrEmpty(vendorStr) && int.TryParse(vendorStr, out var vendorId))
        {
            var vendor = await VendorRepo.GetByIdAsync(vendorId);
            _trn = vendor?.TaxRegNumber ?? string.Empty;
        }

        if (!string.IsNullOrEmpty(_trn))
            _invoices = (await InvoiceRepo.GetByVendorTrnAsync(_trn)).ToList();

        _loading = false;
    }
}
