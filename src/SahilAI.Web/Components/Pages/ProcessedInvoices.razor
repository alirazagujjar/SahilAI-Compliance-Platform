@page "/processed"
@rendermode InteractiveServer
@inject IInvoiceRepository InvoiceRepo
@inject NavigationManager Nav

<PageTitle>Processed Invoices — Sahil AI</PageTitle>

<div class="space-y-6 max-w-7xl">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Processed Invoices</h1>
            <p class="text-slate-500 text-sm mt-0.5">Validated invoices with ZATCA compliance certificates and failed file records.</p>
        </div>
        <button @onclick="RefreshAsync"
                class="flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-sm text-slate-600 transition-colors shadow-sm">
            <svg class="w-4 h-4 @(isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Refresh
        </button>
    </div>

    @if (isLoading)
    {
        <!-- Skeleton loader -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
            @for (var i = 0; i < 6; i++)
            {
                <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden animate-pulse">
                    <div class="h-8 bg-slate-100"></div>
                    <div class="p-4 flex gap-4">
                        <div class="w-20 h-20 bg-slate-100 rounded-lg flex-shrink-0"></div>
                        <div class="flex-1 space-y-2 pt-1">
                            <div class="h-3 bg-slate-100 rounded w-3/4"></div>
                            <div class="h-3 bg-slate-100 rounded w-1/2"></div>
                            <div class="h-5 bg-slate-100 rounded w-2/3 mt-3"></div>
                        </div>
                    </div>
                    <div class="h-10 bg-slate-50 mx-4 mb-4 rounded-lg"></div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Tab bar -->
        <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl w-fit">
            <button @onclick='() => activeTab = "success"'
                    class="px-5 py-2 rounded-lg text-sm font-medium transition-all @(activeTab == "success"
                        ? "bg-white text-slate-800 shadow-sm"
                        : "text-slate-500 hover:text-slate-700")">
                <span class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>
                    Success
                    <span class="text-xs font-bold text-slate-500">@processed.Count()</span>
                </span>
            </button>
            <button @onclick='() => activeTab = "failed"'
                    class="px-5 py-2 rounded-lg text-sm font-medium transition-all @(activeTab == "failed"
                        ? "bg-white text-slate-800 shadow-sm"
                        : "text-slate-500 hover:text-slate-700")">
                <span class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-red-400 inline-block"></span>
                    Failed
                    <span class="text-xs font-bold text-slate-500">@failed.Count()</span>
                </span>
            </button>
        </div>

        <!-- ── SUCCESS TAB ── -->
        @if (activeTab == "success")
        {
            @if (!processed.Any())
            {
                <div class="bg-white rounded-2xl border border-slate-100 py-24 text-center">
                    <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-6 h-6 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <p class="text-slate-500 text-sm">No processed invoices yet.</p>
                    <p class="text-slate-300 text-xs mt-1">Drop an invoice in the inbox to begin.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                    @foreach (var inv in processed)
                    {
                        var hasZatca = inv.Region == ComplianceRegion.SaudiArabia && !string.IsNullOrEmpty(inv.XmlHash);
                        var hasQr    = !string.IsNullOrEmpty(inv.QrCodeBase64);
                        <div class="group bg-white rounded-2xl border @(hasZatca ? "border-emerald-200" : "border-slate-200")
                                    shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 overflow-hidden cursor-pointer"
                             @onclick="@(() => Nav.NavigateTo($"/processed/{inv.Id}"))">

                            <!-- Ribbon -->
                            @if (hasZatca)
                            {
                                <div class="bg-gradient-to-r from-emerald-500 to-teal-500 px-4 py-1.5 flex items-center justify-between">
                                    <span class="text-xs font-bold text-white tracking-widest">✓ ZATCA PHASE 2</span>
                                    <span class="text-white/80 text-xs font-medium">🇸🇦 KSA</span>
                                </div>
                            }
                            else
                            {
                                <div class="bg-gradient-to-r from-slate-600 to-slate-700 px-4 py-1.5 flex items-center justify-between">
                                    <StatusBadge Status="@inv.Status" />
                                    <RegionBadge Region="@inv.Region" />
                                </div>
                            }

                            <!-- Body -->
                            <div class="p-4 flex gap-4">
                                @if (hasQr)
                                {
                                    <div class="flex-shrink-0 w-[72px] h-[72px] bg-white border border-slate-100 rounded-xl overflow-hidden shadow-sm">
                                        <img src="/api/qr/@inv.Id" alt="ZATCA QR"
                                             class="w-full h-full object-contain"
                                             onerror="this.parentElement.style.display='none'" />
                                    </div>
                                }
                                else
                                {
                                    <div class="flex-shrink-0 w-[72px] h-[72px] bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-center text-slate-300">
                                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                    </div>
                                }

                                <div class="min-w-0 flex-1">
                                    <p class="font-mono text-xs font-bold text-indigo-600 truncate">@inv.InvoiceNumber</p>
                                    <p class="text-sm text-slate-600 truncate mt-0.5">@inv.VendorName</p>
                                    <p class="text-lg font-bold text-slate-800 mt-2 leading-none">
                                        @inv.Currency&nbsp;@inv.GrandTotal.ToString("N2")
                                    </p>
                                    <div class="mt-2">
                                        <ConfidenceBar Score="@inv.ConfidenceScore" />
                                    </div>
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="px-4 pb-4 flex items-center justify-between border-t border-slate-50 pt-3">
                                <span class="text-xs text-slate-400">@inv.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
                                <div class="flex items-center gap-2" @onclick:stopPropagation="true">
                                    @if (!string.IsNullOrEmpty(inv.XmlPath) && File.Exists(inv.XmlPath))
                                    {
                                        <a href="/api/xml/@inv.Id"
                                           class="flex items-center gap-1 px-2.5 py-1 text-xs bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg transition-colors font-medium"
                                           title="Download UBL 2.1 XML">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                                            </svg>
                                            XML
                                        </a>
                                    }
                                    <button @onclick="@(() => Nav.NavigateTo($"/processed/{inv.Id}"))"
                                            class="px-2.5 py-1 text-xs bg-indigo-100 hover:bg-indigo-200 text-indigo-700 rounded-lg transition-colors font-medium">
                                        View →
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <!-- ── FAILED TAB ── -->
        @if (activeTab == "failed")
        {
            @if (!failed.Any())
            {
                <div class="bg-white rounded-2xl border border-slate-100 py-24 text-center">
                    <div class="w-12 h-12 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                    </div>
                    <p class="text-slate-700 font-medium">No failures recorded.</p>
                    <p class="text-slate-400 text-sm mt-1">All submitted files have been processed successfully.</p>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var inv in failed)
                    {
                        <div class="bg-white rounded-xl border border-red-100 p-4 flex items-start gap-4 hover:border-red-200 transition-colors">
                            <div class="w-9 h-9 bg-red-50 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="font-mono text-sm font-bold text-slate-700">@inv.InvoiceNumber</span>
                                    <span class="px-2 py-0.5 bg-slate-100 text-slate-500 rounded text-xs font-mono">@inv.FileType</span>
                                    <RegionBadge Region="@inv.Region" />
                                </div>
                                <p class="text-sm text-slate-500 mt-0.5 truncate">@Path.GetFileName(inv.SourceFile)</p>
                                <p class="text-xs text-red-500 mt-1 font-medium">
                                    @(inv.Status == InvoiceStatus.NotSupportedFormat
                                        ? "File format not supported by the configured vision model. Move to a compatible format or upgrade the LLM."
                                        : inv.Status)
                                </p>
                            </div>
                            <div class="flex-shrink-0 text-right">
                                <StatusBadge Status="@inv.Status" />
                                <p class="text-xs text-slate-400 mt-1">@inv.CreatedAt.ToString("dd MMM yyyy")</p>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    private IEnumerable<Invoice> processed = [];
    private IEnumerable<Invoice> failed    = [];
    private string activeTab = "success";
    private bool   isLoading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task RefreshAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        StateHasChanged();
        var t1 = InvoiceRepo.GetProcessedAsync();
        var t2 = InvoiceRepo.GetNotSupportedAsync();
        await Task.WhenAll(t1, t2);
        processed = await t1;
        failed    = await t2;
        isLoading = false;
    }
}
