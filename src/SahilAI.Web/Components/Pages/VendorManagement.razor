@page "/vendor-management"
@attribute [Authorize(Roles = "Admin")]
@inject IVendorRepository VendorRepo
@inject AuthenticationStateProvider AuthState

<PageTitle>Vendor Management — Sahil AI</PageTitle>

<!-- Delete confirmation overlay -->
@if (_deleteTarget is not null)
{
    <div class="fixed inset-0 z-40 bg-black/40 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6">
            <div class="w-12 h-12 rounded-full bg-red-50 border border-red-200 flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <h3 class="text-base font-bold text-slate-800 text-center mb-1">Remove Vendor?</h3>
            <p class="text-sm text-slate-500 text-center mb-6">
                <strong>@_deleteTarget.Name</strong> will be removed. Their invoices will remain but the vendor account will be unlinked.
            </p>
            <div class="flex gap-3">
                <button @onclick="CancelDelete"
                        class="flex-1 px-4 py-2.5 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
                    Cancel
                </button>
                <button @onclick="ConfirmDeleteAsync"
                        class="flex-1 px-4 py-2.5 text-sm font-semibold text-white bg-red-600 hover:bg-red-500 rounded-xl transition-colors">
                    Remove
                </button>
            </div>
        </div>
    </div>
}

<!-- Add / Edit slide-over -->
@if (_panelOpen)
{
    <div class="fixed inset-0 z-30 flex">
        <!-- backdrop -->
        <div class="flex-1 bg-black/30" @onclick="ClosePanel"></div>

        <!-- panel -->
        <div class="w-full max-w-md bg-white shadow-2xl flex flex-col">
            <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
                <h2 class="text-base font-bold text-slate-800">@(_editId.HasValue ? "Edit Vendor" : "Add Vendor")</h2>
                <button @onclick="ClosePanel" class="text-slate-400 hover:text-slate-700 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto px-6 py-5 space-y-4">

                @if (_formError is not null)
                {
                    <div class="px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">@_formError</div>
                }

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Company Name <span class="text-red-500">*</span></label>
                    <input @bind="_form.Name" placeholder="Gulf Shipping & Logistics Co."
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Tax Reg. Number (TRN) <span class="text-red-500">*</span></label>
                    <input @bind="_form.TaxRegNumber" placeholder="300123456700003"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Region</label>
                    <select @bind="_form.Region"
                            class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="SA">Saudi Arabia (KSA)</option>
                        <option value="UAE">UAE</option>
                        <option value="ALL">International</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Email</label>
                    <input @bind="_form.Email" type="email" placeholder="finance@company.com"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Phone</label>
                    <input @bind="_form.Phone" placeholder="+971 4 123 4567"
                           class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Address</label>
                    <textarea @bind="_form.Address" rows="2" placeholder="Office 401, Building 7, Dubai, UAE"
                              class="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none"></textarea>
                </div>

                <div class="flex items-center gap-3 p-4 rounded-xl border @(_form.IsVerified ? "border-emerald-200 bg-emerald-50" : "border-slate-100 bg-slate-50") cursor-pointer transition-colors"
                     @onclick="() => _form.IsVerified = !_form.IsVerified">
                    <div class="w-10 h-6 rounded-full @(_form.IsVerified ? "bg-emerald-500" : "bg-slate-300") transition-colors relative flex-shrink-0">
                        <span class="absolute top-1 @(_form.IsVerified ? "left-5" : "left-1") w-4 h-4 rounded-full bg-white shadow transition-all duration-150 block"></span>
                    </div>
                    <div>
                        <p class="text-sm font-semibold @(_form.IsVerified ? "text-emerald-700" : "text-slate-700")">Mark as Verified</p>
                        <p class="text-xs text-slate-400 mt-0.5">Vendor can access the portal</p>
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 border-t border-slate-100 flex gap-3">
                <button @onclick="ClosePanel"
                        class="flex-1 px-4 py-2.5 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
                    Cancel
                </button>
                <button @onclick="SaveAsync" disabled="@_saving"
                        class="flex-1 px-4 py-2.5 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed rounded-xl transition-colors flex items-center justify-center gap-2">
                    @if (_saving)
                    {
                        <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
                        </svg>
                    }
                    @(_editId.HasValue ? "Save Changes" : "Add Vendor")
                </button>
            </div>
        </div>
    </div>
}

<!-- Page content -->
<div class="max-w-5xl mx-auto">

    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Vendor Management</h1>
            <p class="text-sm text-slate-500 mt-0.5">Add, edit, or remove vendors for your account</p>
        </div>
        <button @onclick="OpenAdd"
                class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl px-4 py-2.5 text-sm transition-colors shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add Vendor
        </button>
    </div>

    @if (_successMsg is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            @_successMsg
        </div>
    }

    <!-- Search + table -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">

        <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-4">
            <div class="relative flex-1 max-w-xs">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0z"/>
                </svg>
                <input @bind="_search" @bind:event="oninput" placeholder="Search by name, TRN or email…"
                       class="w-full pl-8 pr-3 py-1.5 text-sm border border-slate-200 rounded-lg text-slate-700
                              focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent" />
            </div>
            <select @bind="_statusFilter"
                    class="border border-slate-200 rounded-lg px-3 py-1.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-400">
                <option value="">All statuses</option>
                <option value="verified">Verified</option>
                <option value="pending">Pending</option>
            </select>
            <span class="text-xs text-slate-400 ml-auto whitespace-nowrap">@_filtered.Count() of @_vendors.Count</span>
        </div>

        @if (_loading)
        {
            <div class="px-6 py-16 text-center text-slate-400 text-sm">Loading…</div>
        }
        else if (_vendors.Count == 0)
        {
            <div class="px-6 py-16 text-center">
                <svg class="w-12 h-12 text-slate-200 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <p class="text-slate-400 text-sm mb-3">No vendors yet.</p>
                <button @onclick="OpenAdd"
                        class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl px-5 py-2.5 transition-colors">
                    Add your first vendor
                </button>
            </div>
        }
        else if (!_filtered.Any())
        {
            <div class="px-6 py-10 text-center text-slate-400 text-sm">No vendors match your filters.</div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/60">
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Vendor</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">TRN</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Region</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Added</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var v in _filtered)
                    {
                        <tr class="hover:bg-slate-50/60 transition-colors group">
                            <td class="px-6 py-3.5">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-600 font-bold text-xs flex-shrink-0">
                                        @(v.Name.Length > 0 ? v.Name[0].ToString().ToUpper() : "V")
                                    </div>
                                    <div class="min-w-0">
                                        <p class="font-medium text-slate-800 truncate">@v.Name</p>
                                        @if (!string.IsNullOrEmpty(v.Email))
                                        {
                                            <p class="text-xs text-slate-400 truncate">@v.Email</p>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-3.5">
                                <span class="font-mono text-xs text-slate-600 bg-slate-100 rounded px-2 py-0.5">@v.TaxRegNumber</span>
                            </td>
                            <td class="px-4 py-3.5 text-slate-500 text-xs">@v.Region</td>
                            <td class="px-4 py-3.5">
                                @if (v.IsVerified)
                                {
                                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-2.5 py-0.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-2.5 py-0.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>Pending
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3.5 text-slate-400 text-xs">@v.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="px-4 py-3.5">
                                <div class="flex items-center gap-1 justify-end opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button @onclick="() => OpenEdit(v)"
                                            class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors"
                                            title="Edit">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </button>
                                    <button @onclick="() => AskDelete(v)"
                                            class="p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors"
                                            title="Remove">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private bool   _loading      = true;
    private bool   _panelOpen    = false;
    private bool   _saving       = false;
    private int?   _editId       = null;
    private int    _tenantId     = 1;
    private string _search       = string.Empty;
    private string _statusFilter = string.Empty;
    private string? _successMsg;
    private string? _formError;

    private Vendor? _deleteTarget;

    private List<Vendor> _vendors = [];

    private IEnumerable<Vendor> _filtered => _vendors
        .Where(v => string.IsNullOrWhiteSpace(_search)
                    || v.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || v.TaxRegNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (v.Email ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(v => _statusFilter == ""
                    || (_statusFilter == "verified" && v.IsVerified)
                    || (_statusFilter == "pending"  && !v.IsVerified));

    // Transient form model
    private VendorForm _form = new();

    private sealed class VendorForm
    {
        public string  Name          { get; set; } = string.Empty;
        public string  TaxRegNumber  { get; set; } = string.Empty;
        public string  Region        { get; set; } = "SA";
        public string? Email         { get; set; }
        public string? Phone         { get; set; }
        public string? Address       { get; set; }
        public bool    IsVerified    { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var state     = await AuthState.GetAuthenticationStateAsync();
        var tenantStr = state.User.FindFirst("tenant_id")?.Value;
        if (!string.IsNullOrEmpty(tenantStr) && int.TryParse(tenantStr, out var tid))
            _tenantId = tid;

        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _vendors = (await VendorRepo.GetAllByTenantAsync(_tenantId)).ToList();
    }

    // ── Panel ─────────────────────────────────────────────────────────────────

    private void OpenAdd()
    {
        _editId    = null;
        _form      = new();
        _formError = null;
        _panelOpen = true;
    }

    private void OpenEdit(Vendor v)
    {
        _editId = v.Id;
        _form   = new VendorForm
        {
            Name         = v.Name,
            TaxRegNumber = v.TaxRegNumber,
            Region       = v.Region,
            Email        = v.Email,
            Phone        = v.Phone,
            Address      = v.Address,
            IsVerified   = v.IsVerified,
        };
        _formError = null;
        _panelOpen = true;
    }

    private void ClosePanel()
    {
        _panelOpen = false;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_form.Name))        { _formError = "Company name is required."; return; }
        if (string.IsNullOrWhiteSpace(_form.TaxRegNumber)){ _formError = "TRN is required."; return; }

        _saving = true;
        try
        {
            if (_editId.HasValue)
            {
                await VendorRepo.UpdateAsync(new Vendor
                {
                    Id           = _editId.Value,
                    TenantId     = _tenantId,
                    Name         = _form.Name.Trim(),
                    TaxRegNumber = _form.TaxRegNumber.Trim(),
                    Region       = _form.Region,
                    Email        = string.IsNullOrWhiteSpace(_form.Email)   ? null : _form.Email.Trim(),
                    Phone        = string.IsNullOrWhiteSpace(_form.Phone)   ? null : _form.Phone.Trim(),
                    Address      = string.IsNullOrWhiteSpace(_form.Address) ? null : _form.Address.Trim(),
                    IsVerified   = _form.IsVerified,
                });
                _successMsg = $"Vendor \"{_form.Name}\" updated.";
            }
            else
            {
                await VendorRepo.InsertAsync(new Vendor
                {
                    TenantId     = _tenantId,
                    Name         = _form.Name.Trim(),
                    TaxRegNumber = _form.TaxRegNumber.Trim(),
                    Region       = _form.Region,
                    Email        = string.IsNullOrWhiteSpace(_form.Email)   ? null : _form.Email.Trim(),
                    Phone        = string.IsNullOrWhiteSpace(_form.Phone)   ? null : _form.Phone.Trim(),
                    Address      = string.IsNullOrWhiteSpace(_form.Address) ? null : _form.Address.Trim(),
                    IsVerified   = _form.IsVerified,
                    CreatedAt    = DateTime.UtcNow,
                    UpdatedAt    = DateTime.UtcNow,
                });
                _successMsg = $"Vendor \"{_form.Name}\" added.";
            }

            _panelOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = ex.Message.Contains("Duplicate") ? "A vendor with this TRN already exists." : ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Delete ────────────────────────────────────────────────────────────────

    private void AskDelete(Vendor v)    => _deleteTarget = v;
    private void CancelDelete()         => _deleteTarget = null;

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null) return;
        var name = _deleteTarget.Name;
        await VendorRepo.DeleteAsync(_deleteTarget.Id);
        _deleteTarget = null;
        _successMsg   = $"Vendor \"{name}\" removed.";
        await LoadAsync();
    }
}
