@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthState

<div class="flex h-screen overflow-hidden bg-gray-50">
    <NavMenu />
    <div class="flex-1 flex flex-col min-w-0 overflow-auto">

        <!-- Top bar -->
        <header class="flex-shrink-0 bg-white border-b border-slate-100 px-6 py-3 flex items-center justify-between">
            <div></div>
            <div class="flex items-center gap-3">
                @if (_userName is not null)
                {
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-full bg-indigo-600/20 flex items-center justify-center text-indigo-400 text-xs font-bold">
                            @_initials
                        </div>
                        <div class="hidden sm:block text-right">
                            <p class="text-xs font-semibold text-slate-700 leading-tight">@_userName</p>
                            <p class="text-[10px] text-slate-400">@_role</p>
                        </div>
                    </div>
                    <a href="/api/auth/logout"
                       class="flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-800 transition-colors px-2.5 py-1.5 rounded-lg hover:bg-slate-100">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />
                        </svg>
                        Sign out
                    </a>
                }
            </div>
        </header>

        <main class="flex-1 p-6">
            @Body
        </main>
        <footer class="flex-shrink-0 border-t border-slate-100 py-2 px-6 text-xs text-slate-400 text-center">
            Sahil AI &copy; @DateTime.UtcNow.Year &mdash; Agentic Compliance Platform &middot; ZATCA Phase 2
        </footer>
    </div>
</div>

@code {
    private string? _userName;
    private string? _role;
    private string  _initials = "?";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user  = state.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.Identity.Name;
            _role     = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            _initials = string.Concat(
                (_userName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2).Select(w => w[0].ToString().ToUpper()));
        }
    }
}
