@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<div class="flex h-screen overflow-hidden bg-slate-50">

    <!-- Vendor Sidebar -->
    <aside class="w-56 flex-shrink-0 bg-slate-900 text-slate-100 flex flex-col select-none">

        <!-- Logo -->
        <div class="px-5 py-5 flex items-center gap-3 border-b border-slate-800/60">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center font-extrabold text-sm text-white flex-shrink-0 shadow-lg">
                V
            </div>
            <div class="min-w-0">
                <p class="font-bold text-white text-sm leading-tight">Vendor Portal</p>
                <p class="text-[11px] text-slate-500 mt-0.5 truncate">@_companyName</p>
            </div>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-5 space-y-0.5">
            <NavLink href="/vendor" Match="NavLinkMatch.All"
                     class="group flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white transition-all text-sm font-medium"
                     ActiveClass="!bg-emerald-600/20 !text-emerald-300 !border-l-2 !border-emerald-400 !pl-[10px]">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
                </svg>
                <span>Dashboard</span>
            </NavLink>

            <NavLink href="/vendor/upload"
                     class="group flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white transition-all text-sm font-medium"
                     ActiveClass="!bg-emerald-600/20 !text-emerald-300 !border-l-2 !border-emerald-400 !pl-[10px]">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
                <span>Submit Invoice</span>
            </NavLink>

            <NavLink href="/vendor/invoices"
                     class="group flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white transition-all text-sm font-medium"
                     ActiveClass="!bg-emerald-600/20 !text-emerald-300 !border-l-2 !border-emerald-400 !pl-[10px]">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>My Invoices</span>
            </NavLink>
        </nav>

        <!-- Footer -->
        <div class="px-4 py-4 border-t border-slate-800/60 space-y-2">
            @if (_userName is not null)
            {
                <div class="flex items-center gap-2.5 px-2 mb-1">
                    <div class="w-6 h-6 rounded-full bg-emerald-700/60 flex items-center justify-center text-emerald-300 text-[10px] font-bold flex-shrink-0">
                        @_initials
                    </div>
                    <span class="text-[11px] text-slate-400 truncate">@_userName</span>
                </div>
            }
            <a href="/api/auth/logout"
               class="flex items-center gap-2 px-2 py-1.5 rounded-lg text-slate-600 hover:text-slate-300 hover:bg-slate-800/60 transition-all text-[11px] font-medium">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />
                </svg>
                Sign out
            </a>
        </div>
    </aside>

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-w-0 overflow-auto">
        <main class="flex-1 p-6">@Body</main>
        <footer class="flex-shrink-0 border-t border-slate-100 py-2 px-6 text-xs text-slate-400 text-center">
            Sahil AI Vendor Portal &copy; @DateTime.UtcNow.Year &middot; ZATCA Phase 2
        </footer>
    </div>
</div>

@code {
    private string? _userName;
    private string  _initials    = "V";
    private string  _companyName = "Vendor";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user  = state.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName    = user.Identity.Name;
            _companyName = _userName ?? "Vendor";
            _initials    = string.Concat(
                (_userName ?? "V").Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2).Select(w => w[0].ToString().ToUpper()));
        }
    }
}
